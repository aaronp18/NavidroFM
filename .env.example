# Copy this file to `.env` (cp .env.example .env) and fill in your values.
#
# - `docker compose` reads `.env` automatically, so
#   docker-compose-default.yml works without editing the YAML.
# - `make run` sources `.env` too, for local development outside Docker.
# - `.env` is git-ignored: never commit real credentials or cookies.

# --- General -----------------------------------------------------------------
TZ=Europe/London
# Cron expression for the sync job (default: 04:00 every Monday).
SYNC_SCHEDULE="00 4 * * 1"
# Run a sync immediately when the container starts.
RUN_ON_STARTUP="false"

# --- Navidrome ---------------------------------------------------------------
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USERNAME=username
NAVIDROME_PASSWORD=password
# Library id used for selective scans (defaults to 1).
NAVIDROME_LIBRARY_ID="1"

# --- LastFM ------------------------------------------------------------------
LASTFM_USERNAME=
RECOMMENDED="false"
RECOMMENDED_TRACKS="25"
RECOMMENDED_SCHEDULE="0 4 * * 1"
MIX="false"
MIX_TRACKS="25"
MIX_SCHEDULE="0 4 * * 1"
LIBRARY="false"
LIBRARY_TRACKS="50"
LIBRARY_SCHEDULE="0 4 * * 1"

# --- ListenBrainz ------------------------------------------------------------
LZ_USERNAME=
EXPLORATION="false"
EXPLORATION_TRACKS="25"
EXPLORATION_SCHEDULE="0 4 * * 1"
JAMS="false"
JAMS_TRACKS="25"
JAMS_SCHEDULE="0 4 * * 1"

# --- CSV playlists -----------------------------------------------------------
CSV_ENABLED="false"

# --- Downloads ---------------------------------------------------------------
# When false, previously downloaded tracks are kept and re-used.
REMOVE_OLD_TRACKS="false"

# --- Host paths (consumed by docker-compose-default.yml only) ----------------
MUSIC_LIBRARY_PATH=/path/to/music
COOKIES_FILE_PATH=./cookies.txt
BLOCKLIST_FILE_PATH=./blocklist.json
CSV_PLAYLISTS_PATH=./csv_playlists

# --- Local development overrides (optional) ----------------------------------
# Only used when running outside Docker (`make run`, `pytest`). Defaults are the
# container paths (/app/..., /music/...), which usually do not exist locally.
# NAVIDROFM_MUSIC_DIR=./.local/music
# NAVIDROFM_LIBRARY_ROOT=./.local/music
# NAVIDROFM_CSV_DIR=./csv_playlists
# NAVIDROFM_COOKIES_FILE=./cookies.txt
# NAVIDROFM_BLOCKLIST_FILE=./blocklist.json
# NAVIDROFM_LOCK_FILE=/tmp/navidrofm.lock
