{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dev dependencies",
      "type": "shell",
      "command": "make install-dev",
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "make lint",
      "problemMatcher": ["$ruff"]
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "make test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Check (lint + test)",
      "type": "shell",
      "command": "make check",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Docker: compose up",
      "type": "shell",
      "command": "docker compose up -d --build",
      "problemMatcher": []
    },
    {
      "label": "Docker: build image",
      "type": "shell",
      "command": "make docker-build",
      "problemMatcher": []
    }
  ]
}
